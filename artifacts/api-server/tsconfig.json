{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "noEmitOnError": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@workspace/api-client-react": ["../../lib/api-client-react/src/index.ts"]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}