# BrandGen Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Required: Get a free key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Comma-separated list of allowed CORS origins (leave empty to allow all)
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: Server port (default: 3000)
PORT=3000

# Optional: Log level (trace | debug | info | warn | error)
LOG_LEVEL=info

NODE_ENV=development
